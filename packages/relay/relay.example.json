{
  "domain": "relay.example",
  "listen": { "host": "0.0.0.0", "port": 443 },
  "tls": {
    "cert": "/etc/daisy-relay/relay.example.fullchain.pem",
    "key": "/etc/daisy-relay/relay.example.key.pem"
  },
  "logLevel": "info",
  "limits": {
    "maxDaisys": 1000,
    "maxStreamsPerDaisy": 64,
    "bytesPerSecPerDaisy": 16777216
  }
}
