{
  "name": "daisy-monorepo",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/app",
    "packages/*",
    "tests/plugins/*"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node --import tsx packages/daisy/src/main.ts",
    "dev": "npm run start",
    "daisy": "node packages/daisy/bin/daisy.mjs",
    "web": "npm --workspace @daisy-ai/app run web",
    "build:web": "npm --workspace @daisy-ai/app run export:web",
    "typecheck": "tsc --noEmit",
    "gen:api": "node --import tsx scripts/gen-api-docs.ts",
    "gen:i18n": "node --import tsx scripts/gen-i18n-keys.ts",
    "pack:daisy": "node --import tsx scripts/pack-daisy.ts",
    "test": "node --import tsx --import ./tests/no-network.mjs --import ./tests/test-env.mjs --test tests/*.test.ts packages/*/tests/*.test.ts",
    "test:e2e": "node scripts/e2e.cjs",
    "doctor": "node --import tsx scripts/doctor.ts",
    "test:e2e:full": "node scripts/e2e-full.cjs",
    "format": "prettier --write packages apps/app tests scripts docs",
    "test:e2e:commands": "node scripts/e2e-commands.cjs",
    "test:e2e:context": "node scripts/e2e-context.cjs",
    "test:e2e:composer": "node scripts/e2e-composer.cjs",
    "test:e2e:live": "node scripts/e2e-live.cjs",
    "test:e2e:context-usage": "node scripts/e2e-context-usage.cjs",
    "test:e2e:pin": "node scripts/e2e-pin.cjs",
    "test:e2e:sharing": "node scripts/e2e-sharing.cjs",
    "test:e2e:web-origins": "node scripts/e2e-web-origins.cjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.296",
    "@fastify/cors": "^11.3.1",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.9",
    "@fastify/websocket": "^11.3.4",
    "@iarna/toml": "^2.2.5",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "ajv": "8.20.0",
    "fastify": "^5.12.8",
    "jose": "6.2.12",
    "markdown-it": "^15.0.3",
    "node-forge": "1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "^0.86.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@a2a-js/sdk": "1.3.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node-forge": "1.3.14",
    "playwright": "^1.64.0",
    "prettier": "^3.9.9"
  }
}
